{
  "manifest_version": 3,
  "name": "naver-scrap adapter",
  "version": "0.4.4",
  "description": "Thin command adapter between server/ext_bridge.py (ws://127.0.0.1:8765) and this Chrome. No site logic.",
  "permissions": ["tabs", "scripting", "debugger", "alarms"],
  "host_permissions": ["*://*.naver.com/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["*://*.naver.com/*"],
      "js": ["capture_main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.naver.com/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ]
}
