# naver-scrap: per-machine settings. Copy to .env (gitignored) and fill in what you need:
#     cp .env.example .env
# Every value is optional; empty = the default. server/config.py and scripts/naver_api_client.py read .env
# at start; a variable already set in the shell wins. Check the result: .venv/bin/python scripts/check_setup.py

# ---- API server (server/run.py) --------------------------------------------------------------------------

# Port the API listens on. Change it only if 8000 is taken on this machine (`lsof -iTCP:8000 -sTCP:LISTEN`).
# Then set NAVER_API_URL below to the same port.
PORT=8000

# Proxy for every request to Naver (plain HTTP and the server's own Chrome). Leave EMPTY: Naver answers a home
# connection. Set it only if Naver refuses your IP (HTTP 418/429, "접속이 일시적으로 제한"): a STICKY Korean
# residential proxy from your proxy provider's dashboard (session / sticky port), format http://user:pass@host:port
# Example: NAVER_SHOPPING_PROXY=http://user123:pass456@kr.residential.example.com:10001
NAVER_SHOPPING_PROXY=

# Where captcha / stop notices of listing jobs are POSTed as JSON {event, message, details, at}. Empty = a macOS
# notification (allow notifications for your terminal app in System Settings -> Notifications).
# Get a URL from any webhook receiver: a Slack incoming webhook (api.slack.com/apps -> Incoming Webhooks),
# a Telegram bot relay, n8n / Make / Zapier "Webhook" trigger, or webhook.site for a quick test.
# Example: NAVER_NOTIFY_WEBHOOK=https://hooks.slack.com/services/T000/B000/XXXXXXXX
NAVER_NOTIFY_WEBHOOK=

# Seconds the adapter waits for you to answer a Naver captcha in your Chrome before it stops the run (default 600).
# From a phone: open the Mac through a remote-desktop app (e.g. DeskIn); the captcha tab is in front, the cursor in
# the answer field. Example: NAVER_CAPTCHA_WAIT_S=900
NAVER_CAPTCHA_WAIT_S=

# ---- scripts (scripts/naver_api_client.py) ---------------------------------------------------------------

# The API the scripts call. Default http://localhost:8000; set it if the server runs on another port or machine.
# Example: NAVER_API_URL=http://localhost:9000
NAVER_API_URL=

# Seconds a script waits for one API answer (default 900: a cold product details call can take minutes).
NAVER_API_READ_TIMEOUT=

# Which of our Shopify stores the saved photos are prepared for: its name goes into each WebP as publisher and starts
# the file names. One of fairwardgolf (default), skinsli, kyobooks, banafish (scripts/shop_stores.py lists them).
# Example: SHOP_STORE=skinsli
SHOP_STORE=

# PATH of a store's Shopify app credentials file, for the "already in the shop" check (scripts/shopify_catalog.py,
# read only). The file holds PRODUCTS_API_CLIENT_ID and PRODUCTS_API_CLIENT_SECRET of the store's Dev Dashboard app
# (the products app with read_products; not ADMIN_API_*), must be chmod 600 and ignored by git. A 24 h Admin token is
# minted from it on each run and kept in memory only: no token goes in any file. One variable per store, named in
# scripts/shop_stores.py. The operator says where the file is (fairwardgolf: the naver-harvester's .env.fairwardgolf).
# Example: SHOPIFY_CREDENTIALS_FAIRWARDGOLF=/Users/me/Desktop/naver-harvester/development/.env.fairwardgolf
SHOPIFY_CREDENTIALS_FAIRWARDGOLF=

# ---- rarely needed: the server's own Chrome (patchright) ----------------------------------------------------

# Browser channel for the server's Chrome; default "chrome" = the installed Google Chrome. Leave empty.
PATCHRIGHT_CHANNEL=
# Chrome language when no proxy decides it, e.g. ko-KR. Leave empty: Chrome keeps the Mac's own.
PATCHRIGHT_LANG=

# ---- fixed, not configurable here ---------------------------------------------------------------------------
# The browser adapter talks to ws://127.0.0.1:8765 (extension/background.js BRIDGE_URL, server/ext_bridge.py
# PORT). Keep that port free; changing it means editing both files and reloading the extension.
