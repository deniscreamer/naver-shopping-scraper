3abd701c0fe\"><b>makka90@naver.com</b></span></p>\n<!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                    <script type=\"text/data\" class=\"__se_module_data\" data-module-v2=\"{&quot;type&quot;: &quot;v2_text&quot;, &quot;id&quot;: &quot;SE-679399b1-d8c1-11f1-b43c-a598f86d212a&quot;, &quot;data&quot;: {&quot;ctype&quot;: &quot;text&quot;  }}\"></script>\n                </div>                <div class=\"se-component se-image se-l-default\" id=\"SE-679399ab-d8c1-11f1-b43c-f579623d2b19\">\n                    <div class=\"se-component-content se-component-content-fit\">\n                        <div class=\"se-section se-section-image se-l-default se-section-align-center\">\n                                <div class=\"se-module se-module-image\" style=\"\">\n                                    <a class=\"se-module-image-link __se_image_link __se_link\" style=\"\" onclick=\"return false;\" data-linktype=\"img\" data-linkdata=\"{&quot;id&quot;:&quot;SE-679399ab-d8c1-11f1-b43c-f579623d2b19&quot;,&quot;src&quot;:&quot;https://cdn2.domeggook.com/china/domeme/upload/content/tempimg/bane3_m.png&quot;,&quot;originalWidth&quot;:&quot;934&quot;,&quot;originalHeight&quot;:&quot;92&quot;,&quot;linkUse&quot;:&quot;false&quot;,&quot;link&quot;:&quot;&quot;,&quot;fileSize&quot;:&quot;0&quot;}\">\n                                        <img src='data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+ip1sAAAAASUVORK5CYII=' data-src=\"https://cdn2.domeggook.com/china/domeme/upload/content/tempimg/bane3_m.png\"  alt=\"\" class=\"se-image-resource\">\n                                    </a>\n                                </div>\n                        </div>\n                    </div>\n                    <script type=\"text/data\" class=\"__se_module_data\" data-module-v2=\"{&quot;type&quot;: &quot;v2_image&quot;, &quot;id&quot;: &quot;SE-679399ab-d8c1-11f1-b43c-f579623d2b19&quot;, &quot;data&quot;: {&quot;ctype&quot;: &quot;image&quot;, &quot;ai&quot;: &quot;false&quot;, &quot;fileSize&quot;: &quot;0&quot; }}\"></script>\n                </div>\n                <div class=\"se-component se-image se-l-default\" id=\"SE-679399ad-d8c1-11f1-b43c-53fdde90d321\">\n                    <div class=\"se-component-content se-component-content-fit\">\n                        <div class=\"se-section se-section-image se-l-default se-section-align-center\">\n                                <div class=\"se-module se-module-image\" style=\"\">\n                                    <a class=\"se-module-image-link __se_image_link __se_link\" style=\"\" onclick=\"return false;\" data-linktype=\"img\" data-linkdata=\"{&quot;id&quot;:&quot;SE-679399ad-d8c1-11f1-b43c-53fdde90d321&quot;,&quot;src&quot;:&quot;https://cdn2.domeggook.com/china/domeme/upload/content/tempimg/bane4_s.png&quot;,&quot;originalWidth&quot;:&quot;934&quot;,&quot;originalHeight&quot;:&quot;595&quot;,&quot;linkUse&quot;:&quot;false&quot;,&quot;link&quot;:&quot;&quot;,&quot;fileSize&quot;:&quot;0&quot;}\">\n                                        <img src='data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+ip1sAAAAASUVORK5CYII=' data-src=\"https://cdn2.domeggook.com/china/domeme/upload/content/tempimg/bane4_s.png\"  alt=\"\" class=\"se-image-resource\">\n                                    </a>\n                                </div>\n                        </div>\n                    </div>\n                    <script type=\"text/data\" class=\"__se_module_data\" data-module-v2=\"{&quot;type&quot;: &quot;v2_image&quot;, &quot;id&quot;: &quot;SE-679399ad-d8c1-11f1-b43c-53fdde90d321&quot;, &quot;data&quot;: {&quot;ctype&quot;: &quot;image&quot;, &quot;ai&quot;: &quot;false&quot;, &quot;fileSize&quot;: &quot;0&quot; }}\"></script>\n                </div>\n    </div>\n</div>\n",
   "text": "개인정보 제공 동의(위탁판매)\n본 상품은 위탁판매 상품으로 원활한 서비스 제공을 위해 고객님의 개인정보가 아래와 같이 제공됩니다.\n제공받는 자\n공급사정보 (주식회사 감씨)\n제공받는 자의 이용목적\n상품 보관, 포장 및 배송, 교환·반품 처리, 고객 상담\n제공하는 개인정보\n성명, 연락처, 주소, 구매·배송 정보\n제공받는 자의 개인정보 보유 및 이용기간\n이용 목적 달성 시까지 (관련 법령에 따른 보존 필요 시\n해당 기간 동안 보관 후 파기)\n\n※ 주문 확인, 주문 안내, 서비스 계약·이행, 배송상품 발송처리를 위하여 필요한 최소한의 개인정보이므로 동의해주셔야; 상품 구매가 가능하며, 배송은 상기 [제공받는 자]가 지정한 택배사를 통해 진행됩니다.\n\n개인정보 보호책임자\n고객님의 개인정보 처리에 관한 업무를 총괄하여 책임지고, 개인정보 처리와 관련한 고객님의 민원을 처리하기 위하여 아래와 같이\n개인정보 보호책임자를 지정하고 있습니다.\n성명\n이지예\n이메일\nmakka90@naver.com",
