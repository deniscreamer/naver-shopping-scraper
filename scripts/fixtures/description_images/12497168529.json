      {
       "conf": 0.822,
       "text": "[[]BRIDGESTONE GOLF()",
       "y": 306
      },
      {
       "conf": 0.969,
       "text": "구매전 꼭읽어주세요!",
       "y": 971
      },
      {
       "conf": 0.974,
       "text": "필수체크 Q&A",
       "y": 1060
      },
      {
       "conf": 0.995,
       "text": "얼마나 걸리나요?",
       "y": 1201
      },
      {
       "conf": 0.928,
       "text": "평균 7~8일(주말 제오)소요되며,",
       "y": 1269
      },
      {
       "conf": 0.976,
       "text": "물류상황에 따라 2주 이상 소요될 때도 있습니다.",
       "y": 1317
      },
      {
       "conf": 0.984,
       "text": "Q / 정품 맞나요?",
       "y": 1401
      },
      {
       "conf": 0.991,
       "text": "저희는 일본 현지회사이며,전 브랜드",
       "y": 1477
      },
      {
       "conf": 0.975,
       "text": "일본내수용 정품만 취급 및 공급하고 있습니다.",
       "y": 1522
      },
      {
       "conf": 0.999,
       "text": "Q / 주문취소 가능한가요?",
       "y": 1596
      },
      {
       "conf": 0.994,
       "text": "주문확인 이후,바로 현지 공급사에 발주되므로",
       "y": 1687
      },
      {
       "conf": 0.977,
       "text": "취소시에는 / 현지 반품비용을 부담하셔야 합니다.",
       "y": 1727
      },
      {
       "conf": 0.999,
       "text": "관부가세 포함인가요?",
       "y": 1812
      },
      {
       "conf": 0.957,
       "text": "미화 150불 초과시, 세금 발생하며 고객 부담입니다",
       "y": 1888
      },
      {
       "conf": 0.961,
       "text": "※사전에 게시판/톡톡으로 세금 여부 문의 가능",
       "y": 1929
      }
     ],
     "y0": 8439,
     "y1": 10521
    },
    {
     "rows": [
      {
       "conf": 0.991,
       "text": "구매시 유의사항",
       "y": 30
      },
      {
       "conf": 0.994,
       "text": "해외구매대행을 통하여",
       "y": 171
      },
      {
       "conf": 0.997,
       "text": "유통되는 상품입니다.",
       "y": 225
      },
      {
       "conf": 0.98,
       "text": "※주문하신 상품은 현지 구매하여 보내드립니다.",
       "y": 317
      },
      {
       "conf": 0.993,
       "text": "현지 사정에 의해 가격변동 및 품절 발생시,",
       "y": 367
      },
      {
       "conf": 0.974,
       "text": "별도 연락을 드립니다.",
       "y": 422
      },
      {
       "conf": 0.999,
       "text": "발주 / 현지배송 / 상품체크 / 항공발송 / 통관/국내배송",
       "y": 654
      },
      {
       "conf": 0.991,
       "text": "※송장조회는 상품이 세관에서 수입통관이",
       "y": 766
      },
      {
       "conf": 0.998,
       "text": "완료되고,우체국에 인계되는 시점부터 가능",
       "y": 817
      },
      {
       "conf": 0.999,
       "text": "상품가격에는 관부가세가",
       "y": 937
      },
      {
       "conf": 0.984,
       "text": "포함되어 있지 않습니다.",
       "y": 1011
      },
      {
       "conf": 0.978,
       "text": "※150달러 이하의 상품이라도",
       "y": 1109
      },
      {
       "conf": 0.995,
       "text": "다른 곳에서 주문하신 해외 상품과",
       "y": 1160
      },
      {
       "conf": 0.961,
       "text": "같은 날 수입통관이 되어,",
       "y": 1215
      },
      {
       "conf": 0.981,
       "text": "합계액이 150달러 초과시",
       "y": 1268
      },
      {
       "conf": 0.998,
       "text": "관부가세가 발생합니다.",
       "y": 1320
      },
      {
       "conf": 0.995,
       "text": "수령인의 개인통관 고유부호 필수기입!",
       "y": 1457
      },
      {
       "conf": 0.991,
       "text": "※개인통관 고유부호 오기입으로 인한",
       "y": 1508
      },
      {
       "conf": 0.98,
       "text": "취소 및 반품은 접수가 불가합니다.",
       "y": 1560
      },
      {
       "conf": 0.974,
       "text": "수령 후,7일 이내 미개봉 상태의",
       "y": 1690
      },
      {
       "conf": 0.993,
       "text": "상품에 대해서만 반품/교환 가능합니다.",
       "y": 1744
      },
      {
       "conf": 0.946,
       "text": "일부 상품의 경우, 상품 특성상",
       "y": 1786
      },
      {
       "conf": 0.953,
       "text": "반품이 불가한 경우가 있습니다",
       "y": 1849
      }
     ],
