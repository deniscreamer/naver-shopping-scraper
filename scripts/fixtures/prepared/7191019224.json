    ],
    "avatar": "collected/50002788-fixtures/images/7191019224/fairwardgolf-review-avatar-8803cea9d21a0749.webp",
    "tier": "primary",
    "likes": 0,
    "text_grade": "full",
    "text_quality": 47,
    "text_original_ko": "매장에서 아디다스 겨울바지 구매해서 잘 입고 있는데 인터넷 쇼핑하다 저렴한가격의 바지 발견 겨울바지라도 부하지 않고 슬림해보여요 .",
    "text_cut": [
